{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://metal-colts-wash.loca.lt/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://metal-colts-wash.loca.lt/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
